import os

class ManejadorArchivos:
    ARCHIVO_VENTAS = "ventas.csv"

    @staticmethod
    def guardar_venta(venta):
        existe = os.path.exists(ManejadorArchivos.ARCHIVO_VENTAS)

        try:
            with open(ManejadorArchivos.ARCHIVO_VENTAS, "a", encoding="utf-8") as archivo:

                if not existe:
                    archivo.write("Ticket,Fecha,Subtotal,IVA,Total\n")

                fila = f"{venta.get_id()},{venta.get_fecha()},{venta.get_subtotal():.2f},{venta.get_iva():.2f},{venta.get_total():.2f}"

                archivo.write(fila + "\n")

        except IOError as e:
            print("Error al escribir en el archivo de ventas:", e)

    @staticmethod
    def cargar_ventas():
        ventas = []

        if not os.path.exists(ManejadorArchivos.ARCHIVO_VENTAS):
            return ventas

        try:
            with open(ManejadorArchivos.ARCHIVO_VENTAS, "r", encoding="utf-8") as archivo:

                encabezado = True

                for linea in archivo:

                    if encabezado:
                        encabezado = False
                        continue

                    partes = linea.strip().split(",")

                    if len(partes) == 5:
                        id_venta = partes[0].strip()
                        fecha = partes[1].strip()
                        subtotal = float(partes[2].strip())
                        iva = float(partes[3].strip())
                        total = float(partes[4].strip())

                        ventas.append(
                            Venta(id_venta, fecha, subtotal, iva, total)
                        )

        except (IOError, ValueError) as e:
            print("Error al leer el archivo de ventas:", e)

        return ventas

