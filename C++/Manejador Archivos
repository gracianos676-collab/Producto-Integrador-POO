#include <iostream>
#include <fstream>
#include <vector>
#include <string>
#include <sstream>
#include <iomanip>

using namespace std;

class ManejadorArchivos {
private:
    static constexpr const char* ARCHIVO_VENTAS = "ventas.csv";

public:

    static void guardarVenta(Venta venta) {

        ifstream verificar(ARCHIVO_VENTAS);
        bool existe = verificar.good();
        verificar.close();

        ofstream archivo(ARCHIVO_VENTAS, ios::app);

        try {

            if (!existe) {
                archivo << "Ticket,Fecha,Subtotal,IVA,Total\n";
            }

            archivo << venta.getId() << ","
                    << venta.getFecha() << ","
                    << fixed << setprecision(2)
                    << venta.getSubtotal() << ","
                    << venta.getIva() << ","
                    << venta.getTotal()
                    << "\n";

            archivo.close();

        } catch (...) {
            cout << "Error al escribir en el archivo de ventas" << endl;
        }
    }

    static vector<Venta> cargarVentas() {

        vector<Venta> ventas;

        ifstream archivo(ARCHIVO_VENTAS);

        if (!archivo.is_open()) {
            return ventas;
        }

        string linea;
        bool encabezado = true;

        while (getline(archivo, linea)) {

            if (encabezado) {
                encabezado = false;
                continue;
            }

            stringstream ss(linea);
            vector<string> partes;
            string parte;

            while (getline(ss, parte, ',')) {
                partes.push_back(parte);
            }

            if (partes.size() == 5) {

                string id = partes[0];
                string fecha = partes[1];
                double subtotal = stod(partes[2]);
                double iva = stod(partes[3]);
                double total = stod(partes[4]);

                ventas.push_back(
                    Venta(id, fecha, subtotal, iva, total)
                );
            }
        }

        archivo.close();
        return ventas;
    }

    static vector<Producto> cargarProductosDesdeTxt(string ruta) {

        vector<Producto> productos;

        ifstream archivo(ruta);

        if (!archivo.is_open()) {
            cout << "El archivo " << ruta
                 << " no existe. Iniciando con inventario vacío."
                 << endl;

            return productos;
        }

        string linea;

        while (getline(archivo, linea)) {

            if (linea.empty() || linea.find("===") == 0) {
                continue;
            }

            stringstream ss(linea);
            vector<string> partes;
            string parte;

            while (getline(ss, parte, '|')) {
                partes.push_back(parte);
            }

            if (partes.size() >= 2) {

                string idNombre = partes[0];

                size_t puntoIndex = idNombre.find('.');

                int idNumero = stoi(
                    idNombre.substr(0, puntoIndex)
                );

                stringstream formato;
                formato << setw(3)
                        << setfill('0')
                        << idNumero;

                string idFormateado = formato.str();

                string nombre =
                    idNombre.substr(puntoIndex + 1);

                double precio = stod(
                    partes[1]
                    .substr(1)
                );

                productos.push_back(
                    Producto(idFormateado, nombre, precio, 50)
                );
            }
        }

        archivo.close();
        return productos;
    }
};
